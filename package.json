{
  "name": "mortocs-tech-art-agent",
  "private": true,
  "version": "0.1.0",
  "description": "The pane UI for the tech-art agent core",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "protocol",
    "ui"
  ],
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b protocol && tsc -p ui --noEmit",
    "build": "npm run build -w protocol && npm run build -w ui"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
