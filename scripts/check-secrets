#!/usr/bin/env python3
"""Refuse to publish secrets from this PUBLIC repository. Standard library only.

    scripts/check-secrets --staged     what is about to be committed (the pre-commit hook runs this)
    scripts/check-secrets --all        every tracked and untracked, non-ignored file (CI runs this)
    scripts/check-secrets FILE...      just these files

Errors (exit 1):
  * a PRIVATE NAME from the local, gitignored .renames table, in a file, a file name, or (--message) a commit message.
    Reports show the alias, never the name. Without a .renames (CI) this check is skipped.
  * a file that should never be committed: .env, private keys, age key files, 1Password exports, ...
  * a secrets/*.env that is not sops-encrypted, or that holds any plaintext value
  * a secret-shaped string: provider/GitHub/Slack/AWS tokens, age secret keys, PEM private keys, JWTs

Warnings (also exit 1 with --strict, which CI uses): COMPANY DATA that does not belong in a public repo:
1Password references (op://), personal home paths, private IPs, tailnet names, email addresses.
Put `secrets-ok` on a line to suppress a finding on it, with a reason.

This is a tripwire, not a guarantee: gitleaks runs beside it, and GitHub's push protection beside that.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _renames import Renames  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]
MAX_BYTES = 2_000_000
SKIP_CONTENT = re.compile(r"(^|/)(package-lock\.json|uv\.lock|flake\.lock)$|\.(zip|png|jpg|jpeg|gif|ico|woff2?|map|tsbuildinfo)$")

FORBIDDEN_NAMES = [
    (re.compile(r"(^|/)\.env(\.(?!example$|sample$|template$).*)?$"), "an .env file"),
    (re.compile(r"\.(pem|key|p12|pfx|kdbx|ovpn)$"), "a key / certificate / vault file"),
    (re.compile(r"(^|/)keys\.txt$"), "an age keys file"),
    (re.compile(r"\.age$"), "an age-encrypted blob (key wrappers stay out of the repo)"),
    (re.compile(r"(^|/)id_(rsa|dsa|ecdsa|ed25519)(\.pub)?$"), "an SSH key"),
    (re.compile(r"(^|/)(credentials|secrets?)\.(json|ya?ml|txt|toml)$"), "a credentials file"),
    (re.compile(r"(^|/)\.renames$"), "the local private-name table (it lists the very names it hides)"),
]

SECRET_SHAPES = [
    (re.compile(r"AGE-SECRET-KEY-1[A-Z0-9]{20,}"), "an age SECRET key"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "a PEM private key"),
    (re.compile(r"sk-or-v1-[A-Za-z0-9]{20,}"), "an OpenRouter API key"),
    (re.compile(r"sk-ant-[A-Za-z0-9_-]{20,}"), "an Anthropic API key"),
    (re.compile(r"sk-(?:proj-)?[A-Za-z0-9]{32,}"), "an OpenAI-style API key"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}"), "a GitHub token"),
    (re.compile(r"github_pat_[A-Za-z0-9_]{30,}"), "a GitHub fine-grained token"),
    (re.compile(r"\bxox[abpr]-[A-Za-z0-9-]{10,}"), "a Slack token"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "an AWS access key id"),
    (re.compile(r"\beyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}"), "a JWT"),
    (re.compile(r"\bpa-[A-Za-z0-9_-]{30,}"), "a Logfire/Pydantic token"),
    (re.compile(r"\bpylf_v\d+_[a-z]+_[A-Za-z0-9_-]{16,}"), "a Pydantic AI Gateway API key"),
    (re.compile(r"(?i)\b(?:api[_-]?key|secret|token|password)\b[\"']?\s*[:=]\s*[\"'][A-Za-z0-9/+_=-]{24,}[\"']"), "a quoted credential assignment"),
]

COMPANY_DATA = [
    (re.compile(r"op://"), "a 1Password reference (vault and item names are company data)"),
    (re.compile(r"/home/[a-z][a-z0-9_-]*/|/Users/[A-Za-z][A-Za-z0-9_-]*/"), "a personal home path"),
    (re.compile(r"\b(?:10\.\d{1,3}|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}\b"), "a private IP address"),
    (re.compile(r"\b[a-z0-9-]+\.ts\.net\b"), "a tailnet hostname"),
    (re.compile(r"(?<![\w.+-])[\w.+-]+@(?!users\.noreply\.github\.com|example\.(?:com|org)|localhost)[\w-]+\.[a-z]{2,}\b"), "an email address"),
]
SUPPRESS = "secrets-ok"


def git(*args: str) -> str:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=True).stdout


def files_for(mode: str) -> list[str]:
    if mode == "staged":
        return [f for f in git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0") if f]
    return [f for f in git("ls-files", "-z", "-co", "--exclude-standard").split("\0") if f]


def read(path: str, staged: bool) -> str | None:
    try:
        data = subprocess.run(["git", "show", f":{path}"], cwd=ROOT, capture_output=True, check=True).stdout if staged else (ROOT / path).read_bytes()
    except (subprocess.CalledProcessError, OSError):
        return None
    if len(data) > MAX_BYTES or b"\0" in data[:4096]:
        return None
    return data.decode("utf-8", "replace")


def sops_problem(path: str, text: str) -> str | None:
    """None if this secrets/*.env is a properly encrypted sops dotenv file, else why it is not."""
    if "sops_mac=ENC[" not in text:
        return "is not sops-encrypted (no sops_mac): this looks like PLAINTEXT secrets"
    for number, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#") or line.startswith("sops_"):
            continue
        value = line.partition("=")[2]
        if not value.startswith("ENC["):
            return f"line {number} holds a value that is not ENC[...]: partially plaintext"
    return None


def private_names(table: Renames | None, text: str, label: str, show_lines: bool = True) -> list[str]:
    """One error per line of `text` holding a private name. Shows the alias, never the name."""
    if table is None:
        return []
    return [f"{label}{':' + str(n) if show_lines else ''}: contains a private name (alias: {alias}); write the alias instead" for n, alias in table.find(text)]


def check(path: str, staged: bool, table: Renames | None = None) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    errors += private_names(table, path, f"{path} (file name)", show_lines=False)
    is_sops_env = re.fullmatch(r"secrets/[^/]+\.env", path) is not None
    for pattern, what in FORBIDDEN_NAMES:
        if pattern.search(path) and not is_sops_env:
            errors.append(f"{path}: is {what}; it must never be committed")
    if SKIP_CONTENT.search(path):
        return errors, warnings
    text = read(path, staged)
    if text is None:
        return errors, warnings
    if not is_sops_env:  # ciphertext cannot hold a readable name
        errors += private_names(table, text, path)
    if is_sops_env:
        problem = sops_problem(path, text)
        if problem:
            errors.append(f"{path}: {problem}")
        return errors, warnings  # ciphertext: nothing else to read in it
    own_rules = path == "scripts/check-secrets"  # its patterns and docs describe company data without containing any
    for number, line in enumerate(text.splitlines(), 1):
        if SUPPRESS in line:
            continue
        for pattern, what in SECRET_SHAPES:
            if pattern.search(line):
                errors.append(f"{path}:{number}: looks like {what}")  # never print the match itself
        for pattern, what in () if own_rules else COMPANY_DATA:
            if pattern.search(line):
                warnings.append(f"{path}:{number}: {what}")
    return errors, warnings


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--staged", action="store_true")
    group.add_argument("--all", action="store_true")
    parser.add_argument("--strict", action="store_true", help="company-data warnings fail too")
    parser.add_argument("--message", metavar="FILE", help="check a commit message (the commit-msg hook) for private names and secrets")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args(argv)

    table = Renames.load()
    errors: list[str] = []
    warnings: list[str] = []
    staged = args.staged
    if args.message:
        text = Path(args.message).read_text(encoding="utf-8", errors="replace")
        text = "\n".join(line for line in text.splitlines() if not line.startswith("#"))  # git's own comment lines
        errors += private_names(table, text, "commit message")
        errors += [f"commit message:{n}: looks like {what}" for n, line in enumerate(text.splitlines(), 1) for pattern, what in SECRET_SHAPES if pattern.search(line)]
        paths = []
    else:
        paths = args.files or files_for("staged" if staged else "all")
    for path in paths:
        e, w = check(path, staged, table)
        errors += e
        warnings += w

    for line in errors:
        print(f"ERROR   {line}", file=sys.stderr)
    for line in warnings:
        print(f"WARNING {line}", file=sys.stderr)
    failed = bool(errors) or (args.strict and bool(warnings))
    if failed:
        print(
            "\nThis repository is PUBLIC. Fix the above, or if a warning is a deliberate, harmless example, put "
            f"`{SUPPRESS}` and the reason on that line. Never commit a secret: rotate it if one got out.",
            file=sys.stderr,
        )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
