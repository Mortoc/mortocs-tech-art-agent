#!/bin/sh
# This repository is PUBLIC. Check what is about to be committed for secrets and company data.
# Enabled by ./install (git config core.hooksPath .githooks); CI runs the same checks as a backstop.
root=$(cd "$(dirname "$0")/.." && pwd) || exit 1
python3 "$root/scripts/check-secrets" --staged --strict || exit 1
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact --pre-commit >/dev/null 2>&1 || {
    echo "gitleaks found something in the staged changes; run: gitleaks git --staged --redact -v" >&2
    exit 1
  }
fi
